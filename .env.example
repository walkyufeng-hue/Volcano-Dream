api_key=your_new_openrouter_api_key
api_base=https://openrouter.ai/api/v1
model=deepseek/deepseek-v4-flash
image_model=google/gemini-3.1-flash-image
image_fallback_model=recraft/recraft-v4.1
jwt_secret=replace_with_a_long_random_value_before_enabling_login
cache_client_type=memory
feedback_db_path=data/volcano_dream.db

# Comma-separated browser origins allowed to call the API. Add the real domain
# before deploying a separately hosted frontend.
allowed_origins=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Keep this false when FastAPI is directly exposed. Enable it only behind a
# reverse proxy you control, and list that proxy's IP/CIDR below.
trust_proxy_headers=false
trusted_proxy_networks=127.0.0.1/32,::1/128

# Rolling whole-site cost circuit breakers. Set either value to 0 to stop that
# resource immediately without removing the API key.
enable_global_budget=true
global_text_limit=60
global_image_limit=20
global_budget_window_seconds=86400

# Production shared limiter/token storage (choose one):
# cache_client_type=redis
# KV_URL=redis://localhost:6379/0
# cache_client_type=upstash
# KV_REST_API_URL=https://example.upstash.io
# KV_REST_API_TOKEN=your_upstash_token
